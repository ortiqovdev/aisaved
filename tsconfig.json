{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    // Manbada importlar '.ts' bilan yoziladi — Node 24 ularni to'g'ridan-to'g'ri
    // ishga tushiradi (`node src/index.ts`), tsc esa build paytida '.js' ga
    // qayta yozadi. Shu tufayli tsx/esbuild kerak emas.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Node TS'ni faqat "strip" qiladi: enum, namespace, constructor(private x)
    // dev'da (node src/...) yiqiladi — tsc buni build'dan oldin ushlasin
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

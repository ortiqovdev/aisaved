# Bu — SHABLON fayl, u git'ga tushadi.
# Haqiqiy kalitlarni bu yerga EMAS, `.env` fayliga yozing (u .gitignore da).
#   cp .env.example .env

# ---------- Server ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Foydalanuvchiga ko'rsatiladigan vaqtlar mintaqasi (bog'langan vaqt, /status)
BOT_TIMEZONE=Asia/Tashkent

# ---------- MOCK REJIM (ishlab chiqishda) ----------
# MOCK_MODE — umumiy kalit; MOCK_INSTAGRAM / MOCK_AUDD bilan alohida boshqariladi.
# Telegram va Supabase HAR DOIM haqiqiy.
# Mock qilingan servisning kaliti bo'sh bo'lsa ham ilova ishga tushaveradi.
MOCK_MODE=false
# MOCK_INSTAGRAM=true   -> webhook imzosi tekshirilmaydi, DM yuborilmaydi,
#                          /dev/mock/text va /dev/mock/reel endpointlari ochiladi
# MOCK_AUDD=true        -> musiqa aniqlash soxta natija qaytaradi
MOCK_SAMPLE_VIDEO_URL=https://www.w3schools.com/html/mov_bbb.mp4

# ---------- Telegram ----------
# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=

# ---------- Instagram (Meta Graph API) ----------
# Bizning Instagram Professional akkaunt username (@ belgisisiz)
IG_ACCOUNT_USERNAME=bizning_akkaunt
# Meta App -> App settings -> Basic -> App secret (webhook imzosini tekshirish uchun)
IG_APP_SECRET=
# Instagram Login orqali olingan long-lived access token (instagram_business_manage_messages ruxsati bilan)
IG_ACCESS_TOKEN=
# Webhook sozlashda o'zingiz o'ylab topadigan maxfiy satr (Meta panelida ham shuni yozasiz)
IG_WEBHOOK_VERIFY_TOKEN=
# Instagram Login uchun: https://graph.instagram.com/v23.0
# Facebook Login (Page bilan) uchun: https://graph.facebook.com/v23.0
IG_GRAPH_BASE_URL=https://graph.instagram.com/v23.0

# ---------- Musiqa aniqlash ----------
# Tartib: kesh → platforma aytgan qo'shiq (TikTok) → Shazam (bepul) → AudD (pullik zaxira)
# Norasmiy Shazam: bepul, tez; bitta IP'dan juda ko'p so'rov bo'lsa bloklaydi.
SHAZAM_ENABLED=true
# AudD.io — pullik zaxira ($5 / 1000 so'rov). Sukut bo'yicha o'chiq.
AUDD_ENABLED=false
AUDD_API_TOKEN=
# AudD'ga kunlik so'rovlar chegarasi — xarajat oldindan ma'lum (0 = cheksiz)
AUDD_DAILY_LIMIT=100

# ---------- Supabase ----------
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role (secret) key. DIQQAT: hech qachon frontendga chiqarmang!
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Worker (Supabase jadval asosidagi navbat) ----------
WORKER_ENABLED=true
# Bir vaqtda nechta job. Ishning ko'p qismi tarmoqni kutish (resolver,
# yuklash, Telegram) — CPU kam band bo'ladi, 8–16 xavfsiz.
WORKER_CONCURRENCY=8
WORKER_POLL_INTERVAL_MS=3000
WORKER_STALE_LOCK_SECONDS=300
MAX_ATTEMPTS=3
# Telegram sendVideo limiti AYNAN 50MB — zaxira bilan 48MB qo'yilgan.
# 52428800 (50MB) qo'ysangiz, chegaradagi video bizdan o'tib Telegram'da rad etiladi.
MAX_VIDEO_BYTES=50331648
# Bitta foydalanuvchi navbatda ushlab turishi mumkin bo'lgan so'rovlar soni (spam himoyasi).
# 🎵 so'rovlari ham hisobga kiradi — ketma-ket bir nechta reels tashlash oddiy holat.
MAX_PENDING_PER_USER=10
# Tugagan so'rovlar shuncha kundan keyin o'chiriladi (bepul Supabase — 500 MB). 0 — o'chirilmaydi.
REQUESTS_RETENTION_DAYS=30
# Media va qo'shiq keshi shuncha kundan keyin o'chiriladi. 0 — o'chirilmaydi.
CACHE_RETENTION_DAYS=180
# Vaqtinchalik fayllar papkasi (bo'sh qoldirilsa OS tmp ishlatiladi)
TMP_DIR=
# ffmpeg mavjud bo'lsa, audio ajratib yuboriladi (tezroq + arzonroq). false qilsangiz video o'zi yuboriladi.
USE_FFMPEG=true
FFMPEG_PATH=ffmpeg

# ---------- Musiqa aniqlash sifati ----------
# AudD'ga yuboriladigan parcha uzunligi (sekund). Uzunroq = aniqroq, lekin sekinroq.
AUDD_SNIPPET_SECONDS=15
# Birinchi parchada topilmasa, videoning O'RTASIDAN va boshqa joyidan qayta urinish.
# Reels boshida ko'pincha gap/sukunat bo'ladi, shuning uchun aniqlash sifatini
# sezilarli oshiradi — ammo AudD so'rovlarini ko'paytiradi. Limit tor bo'lsa false.
AUDD_MULTI_PASS=true
# Bir xil fayl qayta yuborilsa, avvalgi natijani qayta ishlatish (AudD limitini tejaydi)
RESULT_CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# Instagram HAVOLASIDAN video topuvchi tashqi xizmat (ixtiyoriy)
#
# Meta rasmiy API orqali BOSHQA odamning reels faylini bermaydi (tekshirilgan:
# Graph API "missing permissions", CDN imzosiz 404). Shuning uchun "havolani
# tashla — videoni olib beray" oqimi tashqi endpointga tayanadi.
#
# Bo'sh qoldirilsa: bot havolani qabul qiladi, lekin "hozircha yoqilmagan"
# deb javob beradi. Qolgan hamma narsa (video/audio tashlash, Instagram DM)
# o'zgarishsiz ishlaydi.
#
# `{url}` shabloni haqiqiy havola bilan almashtiriladi. Shablon yozilmasa,
# havola `?url=` parametri sifatida qo'shiladi.
# ---------------------------------------------------------------------------
IG_RESOLVER_URL=
# GET (default) yoki POST. POST bo'lsa tanaga {"url":"..."} yuboriladi.
IG_RESOLVER_METHOD=GET
# Qo'shimcha sarlavhalar, JSON obyekt. Masalan:
# IG_RESOLVER_HEADERS={"x-rapidapi-key":"...","x-rapidapi-host":"..."}
IG_RESOLVER_HEADERS=
# Javobdagi video havolasining yo'li, masalan: data.media.0.url
# Bo'sh qoldirilsa javob ichidan avtomatik qidiriladi (ko'p provayder uchun yetarli).
IG_RESOLVER_VIDEO_PATH=
IG_RESOLVER_TITLE_PATH=
IG_RESOLVER_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Boshqa platformalar: TikTok, YouTube Shorts, Pinterest
# (src/services/resolvers.ts). Havola Telegram botga yoki guruhga tashlanadi,
# inline rejimda ham ishlaydi: @bot <havola>
# ---------------------------------------------------------------------------
# TikTok — tikwm-mos API. Bepul, kalitsiz (1 so'rov/soniya). Bo'sh qoldirilsa
# TikTok o'chiq. Diqqat: O'zbekistonda TikTok CDN'i yopiq — video Telegram'ga
# URL orqali beriladi (Telegram uni o'zi oladi); yuklab olish zaxirasi faqat
# chet eldagi serverda ishlaydi.
TIKTOK_RESOLVER_URL=https://www.tikwm.com/api/?url={url}&hd=1
# Pinterest — ochiq widget API, kalit kerak emas
PINTEREST_ENABLED=true
# YouTube Shorts — yt-dlp (+ ffmpeg). Windows: winget install yt-dlp.yt-dlp
YTDLP_PATH=yt-dlp
# Shundan uzun YouTube videolari yuklanmaydi (sekund)
YOUTUBE_MAX_SECONDS=600
